# VoxGuard Backend Configuration Template
# Copy this file to .env and fill in your details:
# NEVER commit your actual .env file to GitHub!

# Cloud PostgreSQL Database URL (e.g. Neon, Supabase, Render, Railway, AWS RDS)
# Format: postgresql://[user]:[password]@[host]:[port]/[database]?sslmode=require
# If left empty, VoxGuard will fallback to local SQLite (backend/voxguard.db)
DATABASE_URL=postgresql://username:password@ep-sample-pooler.us-east-2.aws.neon.tech/voxguard?sslmode=require

# Application Secret Key for JWT / Session Signing
SECRET_KEY=change_this_to_a_secure_random_64_char_hex_string

# Allowed CORS Origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,https://your-frontend-deployment.vercel.app

# Environment Mode
ENVIRONMENT=production
